# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 jukebox contributors
#
# Copy to .env, fill in, then: docker compose up -d --build
# Never commit .env. Every value here is read from the environment.

# --------------------------------------------------------------------- Discord
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Optional: sync slash commands to one guild instantly while developing.
DISCORD_GUILD_ID=

# Public repository URL. Required: /source shows it to satisfy AGPL section 13.
REPO_URL=https://github.com/your-org/jukebox

# -------------------------------------------------------------------- Lavalink
# Shared with the Lavalink container (mapped to LAVALINK_SERVER_PASSWORD).
LAVALINK_PASSWORD=
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_SECURE=false
LAVALINK_REGION=default
LAVALINK_NAME=main
# Seconds the node keeps a session alive for a reconnecting client.
LAVALINK_RESUME_TIMEOUT=300
# Java heap for the node; used by docker-compose only.
JAVA_OPTIONS=-Xms256m -Xmx1G
LAVALINK_LOG_LEVEL=INFO

# --------------------------------------------------------------------- Sources
# Plain-text searches use this source: youtube, youtube_music, soundcloud,
# spotify, apple_music, deezer.
DEFAULT_SOURCE=youtube

SOURCE_YOUTUBE=true
SOURCE_SOUNDCLOUD=true
SOURCE_BANDCAMP=true
SOURCE_HTTP=true
SOURCE_SPOTIFY=false
SOURCE_APPLE_MUSIC=false
SOURCE_DEEZER=false

# Spotify (required when SOURCE_SPOTIFY=true). Metadata is mirrored to YouTube.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music (required when SOURCE_APPLE_MUSIC=true). Metadata is mirrored to YouTube.
APPLE_MUSIC_TOKEN=

# Deezer (required when SOURCE_DEEZER=true). LavaSrc plays Deezer directly.
DEEZER_ARL=
DEEZER_MASTER_DECRYPTION_KEY=

# Optional YouTube hardening. poToken applies to WEB/WEBEMBEDDED clients.
YOUTUBE_POT_TOKEN=
YOUTUBE_VISITOR_DATA=
# Optional YouTube OAuth (burner account only).
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ------------------------------------------------------------------- Behaviour
# Seconds with nothing playing before the bot leaves voice. 0 disables.
IDLE_TIMEOUT=300
# Seconds the bot waits alone in a channel before leaving. 0 disables.
EMPTY_TIMEOUT=30
DEFAULT_VOLUME=70
MAX_QUEUE_SIZE=1000
# How often positions are flushed to SQLite while playing.
STATE_FLUSH_INTERVAL=15
RESTORE_ON_START=true
SHUTDOWN_TIMEOUT=15

# --------------------------------------------------------------------- Runtime
DATABASE_PATH=./data/jukebox.db
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
LOG_LEVEL=INFO
LOG_JSON=true
