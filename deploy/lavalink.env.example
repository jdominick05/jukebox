#
# /etc/jukebox/lavalink.env  (systemd, non-Docker)
#
# Lavalink reads these directly (environment variables override
# application.yml).  Keep the values in sync with jukebox.env: the bot's
# SOURCE_* switches must match these PLUGINS_* switches.
# Keep mode 0640 root:lavalink.

LAVALINK_SERVER_PASSWORD=

PLUGINS_YOUTUBE_ENABLED=true
PLUGINS_YOUTUBE_POT_TOKEN=
PLUGINS_YOUTUBE_POT_VISITOR_DATA=
PLUGINS_YOUTUBE_OAUTH_ENABLED=false
PLUGINS_YOUTUBE_OAUTH_REFRESH_TOKEN=

PLUGINS_LAVASRC_SOURCES_SPOTIFY=false
PLUGINS_LAVASRC_SPOTIFY_CLIENT_ID=
PLUGINS_LAVASRC_SPOTIFY_CLIENT_SECRET=

PLUGINS_LAVASRC_SOURCES_APPLEMUSIC=false
PLUGINS_LAVASRC_APPLEMUSIC_MEDIA_API_TOKEN=

# Deezer streams: set this to true and fill both values below.  application.yml
# enables the Deezer source by default, so leaving it false explicitly switches
# it off; always keep the bot's SOURCE_DEEZER in sync with this switch.
PLUGINS_LAVASRC_SOURCES_DEEZER=false
PLUGINS_LAVASRC_DEEZER_ARL=
PLUGINS_LAVASRC_DEEZER_MASTER_DECRYPTION_KEY=

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_LAVALINK=INFO
