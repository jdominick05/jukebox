#
# /etc/jukebox/jukebox.env  (systemd, non-Docker)
# Copy from this file and fill in. Keep mode 0640 root:jukebox.

DISCORD_TOKEN=
DISCORD_GUILD_ID=
REPO_URL=https://github.com/jdominick05/jukebox

LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_RESUME_TIMEOUT=300

DEFAULT_SOURCE=youtube
SOURCE_YOUTUBE=true
SOURCE_SOUNDCLOUD=true
SOURCE_BANDCAMP=true
SOURCE_HTTP=true
SOURCE_SPOTIFY=false
SOURCE_APPLE_MUSIC=false
SOURCE_DEEZER=false

# Deezer stream mode: set SOURCE_DEEZER=true, DEFAULT_SOURCE=deezer and
# SOURCE_YOUTUBE=false, then fill DEEZER_ARL and DEEZER_MASTER_DECRYPTION_KEY
# below.  Keep these in sync with PLUGINS_LAVASRC_SOURCES_DEEZER in lavalink.env.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_TOKEN=
DEEZER_ARL=
DEEZER_MASTER_DECRYPTION_KEY=

YOUTUBE_POT_TOKEN=
YOUTUBE_VISITOR_DATA=

IDLE_TIMEOUT=300
EMPTY_TIMEOUT=30
DEFAULT_VOLUME=70
MAX_QUEUE_SIZE=1000
STATE_FLUSH_INTERVAL=15
RESTORE_ON_START=true
SHUTDOWN_TIMEOUT=15

DATABASE_PATH=/var/lib/jukebox/jukebox.db
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
LOG_LEVEL=INFO
LOG_JSON=true
